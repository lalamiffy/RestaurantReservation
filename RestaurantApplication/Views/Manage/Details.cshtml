@model Sitting
@{
    ViewData["Title"] = "Details";
}

<h1><a href="~/Manage/Index/">Manage Sittings</a> - Details </h1>
<div style="border: 1px solid black; padding:5px; margin:5px">
    <h2>@Model.SittingType.Name - @Model.StartTime.ToString("dd/MM/yyyy") </h2>
    
    <p>Start Time: @Model.StartTime </p>
    <p>End Time: @Model.EndTime </p>
    <p>Capacity: @Model.Capacity</p>
    <p>Vacancies: @Model.Vacancies</p>
    <p>Active: @(Model.Active? "Yes" : "No")</p>
   

</div>




<div>

    <a asp-action="SittingsDelete" asp-route-id="@Model.Id">Delete</a> |
    <a asp-action="SittingsEdit" asp-route-id="@Model.Id">Edit</a> |
    <a href="~/Manage/Index/">Back to Sittings List</a>
</div>

