<div style="margin-top:20px" >
    <table id="example" class="display" style="width:100%">

        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Date</th>
                <th scope="col">Sitting Type</th>
                <th scope="col">Start time</th>
                <th scope="col">End time</th>
                <th scope="col">Capacity</th>
                <th scope="col">Vacancies</th>
                <th scope="col">Active</th>
                <th scope="col">Operation</th>
            </tr>
        </thead>
        
        <tbody>
            @foreach (var s in Model){
            <tr>
                <th scope="row">@s.Id</th>
                <td>@s.StartTime.ToString("yyyy-MM-dd")</td>
                <td>@s.SittingType.Name</td>
                <td>@s.StartTime.ToString("hh:mm tt")</td>
                <td>@s.EndTime.ToString("hh:mm tt")</td>
                <td>@s.Capacity</td>
                <td>@s.Vacancies</td>
                <td>@(s.Active ? "Yes" : "No")</td>
                <td><a asp-action="SittingsDelete" asp-route-id="@s.Id">Delete</a> |
            <a asp-action="Details" asp-route-id="@s.Id">Details</a> |
            <a asp-action="SittingsEdit" asp-route-id="@s.Id">Edit</a> |</td>
            </tr>
            }
        </tbody>
    </table>

</div>
<script src="https://code.jquery.com/jquery-3.5.1.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>


<script>
    
$(document).ready(function() {
    let table = new DataTable('#example');

    $('#example').DataTable({
            order: [[3, 'desc']],
    });
});
</script>
