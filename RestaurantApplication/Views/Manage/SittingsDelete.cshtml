@model Sitting
@{
    ViewData["Title"] = "SittingsDelete";
}

<h1>Manage Sittings - <a href="~/Manage/Index/">Sittings</a> - Delete</h1>
<div style="border: 1px solid black; padding:15px; margin:5px">

    <h2>Are you sure to delete this sitting:</h2>

    <div style="background-color: yellow; padding:5px; margin:5px">
        <p>Sitting Type: @Model.SittingType.Name </p>
        <p>Sitting Date: @Model.StartTime.ToString("dd/MM/yyyy") </p>
        <p>Time: @Model.StartTime.ToString("hh:mm tt") - @Model.EndTime.ToString("hh:mm tt")  </p>
        <p>Capacity: @Model.Capacity </p>
        <p>Active: @Model.Active </p>
    </div>

    <form asp-action="SittingsDelete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm to Delete" />
    </form>

</div>

