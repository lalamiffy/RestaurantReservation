@model Sitting
@{
    ViewData["Title"] = "SittingsEdit";
}

<h1>SittingsEdit</h1>
<h1>Manage Sittings - <a href="~/Manage/Index/">Sittings</a> - Edit</h1>

<div style="border: 1px solid black; padding:15px; margin:5px">

    <h2>Sitting Id: @Model.Id - @Model.SittingType.Name</h2>

    @if (Model?.Reservations.Count > 0 )
    {
        <p style="color:red; font-weight:300">"Sorry the sitting can't be modified as it has one or more reservations'"</p>
     
    }



    <form asp-controller="Manage" asp-action="SittingsEdit" >

        <div>
            <label>Start Time: </label>
            <input asp-for="StartTime"
            disabled= "@(Model.Reservations.Count > 0)"/>
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div>
            <label>End Time: </label>
            <input asp-for="EndTime"
            disabled= "@(Model.Reservations.Count > 0)"/>
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>

        <div>
            <label>Capacity: </label>
            <input asp-for="Capacity" 
            disabled= "@(Model.Reservations.Count > 0)"/>
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>

        <div>
            <label>Active: </label>
            <input asp-for="Active" />
            <span asp-validation-for="Active" class="text-danger"></span>
        </div>

        <input type="submit" value="Save"/>
    
    </form>

</div>

