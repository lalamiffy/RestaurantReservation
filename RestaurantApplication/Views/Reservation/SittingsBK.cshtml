@model IEnumerable<Sitting>
@{
    ViewData["Title"] = "Sittings";
}


<section style="margin-top: 100px" class="module pt-0 pb-0">
    <div class="row position-relative m-0">
        <div class="row">
            <div class="col-sm-12">
                <h2 class="module-title font-alt align-left">Sittings List</h2>
                <p class="module-subtitle font-serif align-left">Bean Scean Administation Board</p>

                <section style="margin-bottom: 410px" class="module pt-0 pb-0">

@*<h1> <a href="~/Reservation/SittingsBK">Reservation</a>  - Sitting List </h1>
*@<div class="form-control">
    <div class="input-group date" data-provide="datepicker" >
        <label for="datepicker">Select a date:</label>

        <div class="input-group-date" id="datepicker">
            <span class="glyphicon glyphicon-th">
                <i class="fade fa-calander"></i>
            </span>
        </div>
    </div>
</div>


<div id="sittings-container">

    @foreach (var s in Model)
    {
        <div>
            <a asp-action="Create" asp-route-id="@s.Id" class="form-control mt-1">
                <p>@s.StartTime.ToString("yyyy-MM-dd") @s.SittingType.Name @s.StartTime.ToString("hh:mm tt") - @s.EndTime.ToString("hh:mm tt") </p>
            </a>
        </div>
    }
</div>
<input value="Select" class="form-control"/>


@section Scripts{
    <script src="~/js/booking.sitting.js"></script>
}

            </div>
        </div>
    </div>
